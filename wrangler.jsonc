{
  "name": "bgdnv",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-17",

  "assets": {
    "directory": "./bgdnvmusic",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "INSTAGRAM_KV",
      "id": "c9aa9443f6aa4d4ea9627dfdb840a237"
    }
  ],

  "triggers": {
    "crons": ["0 3 * * *"]
  }

}


  
 